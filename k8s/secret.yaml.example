# Copy this file to secret.yaml and fill in your actual values
# DO NOT commit secret.yaml to version control
#
# Apply with: kubectl apply -f secret.yaml -n wan-dns-sync
apiVersion: v1
kind: Secret
metadata:
  name: wan-dns-sync-secrets
type: Opaque
stringData:
  OPNSENSE_API_KEY: "<your-opnsense-api-key>"
  OPNSENSE_API_SECRET: "<your-opnsense-api-secret>"
  # The token of every provider the config uses: HCLOUD_TOKEN for hetzner, DESEC_TOKEN for desec
  HCLOUD_TOKEN: "<your-hetzner-cloud-api-token>"
